server:
  port: 8090
  max-http-request-header-size: 16KB
  servlet:
    session:
      cookie:
        http-only: true
        same-site: strict
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/uem_wiki_contrib?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
    username: ${DB_USER:uemwiki}
    password: ${DB_PASSWORD:change-me}
  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 11MB
  thymeleaf:
    cache: false
mybatis-plus:
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.nologging.NoLoggingImpl
contrib:
  upload-dir: ${UPLOAD_DIR:./data/private-uploads}
  export-dir: ${EXPORT_DIR:./export}
  admin-user: ${ADMIN_USER:admin}
  admin-password-hash: ${ADMIN_PASSWORD_HASH:}
  github-token: ${GITHUB_TOKEN:}
  github-repo: ${GITHUB_REPO:}
  github-branch: ${GITHUB_BRANCH:main}
  wiki-root: ${WIKI_ROOT:../}
